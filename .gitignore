# 数据只在训练机器之间单独传输，不进入 Git 云端。
/data/
/datasets/
/replays/
/captured_replays*/
/replay_shards*/
*.rep
*.npz
*.npy
*.csv
*.tsv
*.parquet
*.arrow
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# 模型、训练记录和实战报告属于运行产物。
/outputs/
/checkpoints/
/runs/
/logs/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.log
*.jsonl
events.out.tfevents.*

# 数据/模型的打包副本也不上传。
*.zip
*.7z
*.rar
*.tar
*.gz
*.tgz
*.bz2
*.xz
*.zst

# Python / Node 依赖、缓存和构建产物；保留 package-lock.json。
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
/env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
node_modules/
dist/
build/
*.tsbuildinfo
*.dll
*.exe
*.pyd
*.so
*.lib
*.obj
*.o

# 各机器的路径/调参副本、凭证及编辑器状态。
